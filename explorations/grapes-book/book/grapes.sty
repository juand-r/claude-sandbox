% grapes.sty -- layout for the book "Grapes". All layout decisions live here.
% Engine: LuaLaTeX. Class: book.
%
% ---- What the author uses ---------------------------------------------------
%   \note[key]{...}     footnote at the foot of the page. Marks 1, 2, 3,
%                       restarting each chapter.
%   \subnote[key]{...}  note on a note; only inside \note. Own block below the
%                       notes, under its own rule. Marks a, b, c, restarting
%                       each page.
%   \aside[key]{...}    margin note. Marks *, †, ‡, §, ¶, ‖ (then doubled),
%                       restarting each page. May contain \note's, whose text
%                       goes to the foot of the page as usual.
%   \anchor{key}        a mark (❧) in the text that a note can point back to.
%                       Put it at the START of the sentence it marks: it is
%                       a destination (see STYLE.md).
%   \xref{key}          prints the mark of the note or anchor named key,
%                       adding ", p. N" when it is on another page. It is a
%                       link in the PDF.
% [key] is optional; give one only to notes you want to refer to.
% Every mark is a link in the PDF: from the text to its note, and back.
%
% ---- Margin notes can be switched off without touching the text -------------
%   \usepackage{grapes}             asides in the margin (default)
%   \usepackage[nomargin]{grapes}   asides go to the foot, in their own block
%                                   above the notes, with the same symbols;
%                                   the page drops the wide margin.
%
% ---- Misuse stops the build with an error naming the line -------------------
%   \note inside a note (use \subnote); \subnote outside a \note, or inside a
%   \subnote; \aside inside a note or inside an \aside; an \aside taller than
%   the page. Warnings, which build.sh turns into failures on the final pass:
%   more than nine asides on one page, undefined or duplicate keys.
%   An \aside longer than a third of the page only warns.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{grapes}[2026/09/30 Layout for Grapes]

\newif\ifgrapes@margin
\DeclareOption{margin}{\grapes@margintrue}
\DeclareOption{nomargin}{\grapes@marginfalse}
\ExecuteOptions{margin}
\ProcessOptions\relax

% ---- page ------------------------------------------------------------------
% With margin notes the page is wider, to make room for them. Without them it
% is a plain trade page. Change the numbers here and nowhere else.
\ifgrapes@margin
  \RequirePackage[paperwidth=7in, paperheight=9.5in,
                  textwidth=3.9in, textheight=7.3in,
                  inner=0.85in, top=0.9in,
                  marginparwidth=1.6in, marginparsep=0.3in]{geometry}
\else
  \RequirePackage[paperwidth=5.5in, paperheight=8.5in,
                  textwidth=3.9in, textheight=6.6in,
                  inner=0.7in, top=0.8in]{geometry}
\fi

% ---- type ------------------------------------------------------------------
\RequirePackage{fontspec}
\setmainfont{EB Garamond}[Numbers={OldStyle,Proportional}]
\RequirePackage{microtype}
\setlength\emergencystretch{1em}
\linespread{1.08}
\RequirePackage{xcolor}
\definecolor{grapeink}{HTML}{5B2A4E}   % the one accent colour

% ---- chapters and running heads -------------------------------------------
% Chapters are numbered in words ("One"), up to twenty; after that, digits.
\newcommand\grapes@numberword[1]{%
  \ifcase#1 Zero\or One\or Two\or Three\or Four\or Five\or Six\or Seven\or
  Eight\or Nine\or Ten\or Eleven\or Twelve\or Thirteen\or Fourteen\or
  Fifteen\or Sixteen\or Seventeen\or Eighteen\or Nineteen\or Twenty\else
  \number#1\fi}
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\centering\normalfont}
  {\large\scshape\color{grapeink}\grapes@numberword{\value{chapter}}}
  {0.5\baselineskip}
  {\LARGE}
\titlespacing*{\chapter}{0pt}{0.15\textheight}{3\baselineskip}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\renewcommand\chaptermark[1]{\markboth{#1}{#1}}
\fancyhead[LE]{\small\scshape Grapes}
\fancyhead[RO]{\small\scshape\leftmark}
\fancyfoot[C]{\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}}

% ---- notes: bigfoot series ---------------------------------------------------
% Three series, stacked at the foot in declaration order: asides (only with
% [nomargin]), notes, subnotes: the order of the chain aside -> note ->
% subnote. (bigfoot lets a note contain notes of LATER series only.) [ruled]
% puts a rule above each series present on the page; a page with notes only
% shows one rule.
\RequirePackage[ruled]{bigfoot}
\DeclareNewFootnote{S}          % asides; used as a series only in nomargin
\DeclareNewFootnote{default}
\DeclareNewFootnote{B}[alph]
\RequirePackage{perpage}
\MakePerPage{footnoteB}
\MakePerPage{footnoteS}         % the aside counter, in both modes

% Aside marks. After nine on one page there are no more; the mark becomes
% "?" and a warning is written (build.sh fails on it).
\newcommand\grapes@symbol[1]{%
  \ifcase#1\or *\or †\or ‡\or §\or ¶\or ‖\or **\or ††\or ‡‡\else ?\fi}
\renewcommand\thefootnoteS{\grapes@symbol{\value{footnoteS}}}
\newcommand\grapes@checksymbols{%
  \ifnum\value{footnoteS}>9
    \PackageWarning{grapes}{More than nine asides on one page}%
  \fi}

% ---- links between marks and notes -----------------------------------------------
% Each note gets a running id. Its mark in the text is target grapes-t<id>
% and links to grapes-b<id>; its mark in the note is target grapes-b<id> and
% links back. bigfoot typesets both marks through \@makefnmark, and the one
% in the note through \@makefntext, which sets \ifgrapes@bodymark.
\newcount\grapes@idcount
\newcommand\grapes@linkid{0}
\newcommand\grapes@newid{%
  \global\advance\grapes@idcount 1
  \xdef\grapes@linkid{\the\grapes@idcount}}
\newif\ifgrapes@bodymark
\newcommand\grapes@linkedmark[1]{%
  \ifgrapes@bodymark
    \hypertarget{grapes-b\grapes@linkid}{}\hyperlink{grapes-t\grapes@linkid}{#1}%
  \else
    \hypertarget{grapes-t\grapes@linkid}{}\hyperlink{grapes-b\grapes@linkid}{#1}%
  \fi}
\renewcommand\@makefnmark{%
  \hbox{\@textsuperscript{\normalfont\grapes@linkedmark{\@thefnmark}}}}
\renewcommand\@makefntext[1]{%
  \parindent 1em\noindent
  \hb@xt@1.8em{\hss{\grapes@bodymarktrue\@makefnmark}}#1}

% ---- keys and cross-references -------------------------------------------------
% A keyed note puts target grapes:<key> and \label{grapes:<key>} at the start
% of its text; the label's value is the note's mark.
\newcommand\grapes@keytarget[2]{% #1 key (may be empty), #2 mark
  \if\relax\detokenize{#1}\relax\else
    \hypertarget{grapes:#1}{}%
    \protected@edef\@currentlabel{#2}%
    \label{grapes:#1}%
  \fi}
\RequirePackage{refcount}
\newcount\grapes@xrefcount
\newcommand\xref[1]{%
  \global\advance\grapes@xrefcount 1
  \edef\grapes@here{grapes@xref\the\grapes@xrefcount}%
  \label{\grapes@here}%
  \hyperlink{grapes:#1}{\ref*{grapes:#1}}%
  \edef\grapes@pagehere{\getpagerefnumber{\grapes@here}}%
  \edef\grapes@pagethere{\getpagerefnumber{grapes:#1}}%
  \ifx\grapes@pagehere\grapes@pagethere\else, p.~\pageref*{grapes:#1}\fi}
\newcommand\anchormark{❧}
% The link target goes before the mark, so a jump lands at the start.
\newcommand\anchor[1]{%
  \grapes@keytarget{#1}{\anchormark}\textsuperscript{\anchormark}}

% ---- where we are, so misuse can be caught ----------------------------------------
\newif\ifgrapes@innote
\newif\ifgrapes@insubnote
\newif\ifgrapes@inaside
% Body wrappers: each sets the flags for text inside it.
\newcommand\grapes@notebody[2]{% #1 key, #2 text
  \grapes@innotetrue\grapes@insubnotefalse\grapes@inasidefalse
  \grapes@keytarget{#1}{\@thefnmark}#2}
\newcommand\grapes@subnotebody[2]{%
  \grapes@innotetrue\grapes@insubnotetrue\grapes@inasidefalse
  \grapes@keytarget{#1}{\@thefnmark}#2}
\newcommand\grapes@asideflags{%
  \grapes@inasidetrue\grapes@innotefalse\grapes@insubnotefalse}

% ---- \note and \subnote ---------------------------------------------------------------
\NewDocumentCommand\note{O{} +m}{%
  \ifgrapes@innote
    \PackageError{grapes}{\string\note\space inside a note}{%
      For a note on a note, use \string\subnote.}%
  \fi
  \grapes@newid
  \ifgrapes@inaside
    \grapes@deferrednote{#1}{#2}% a note inside an aside
  \else
    \footnote{\grapes@notebody{#1}{#2}}%
  \fi}

\NewDocumentCommand\subnote{O{} +m}{%
  \ifgrapes@insubnote
    \PackageError{grapes}{\string\subnote\space inside a \string\subnote}{%
      Only two levels of notes are set up.}%
  \fi
  \ifgrapes@innote\else
    \ifgrapes@inaside
      \PackageError{grapes}{\string\subnote\space directly inside an
        \string\aside}{An aside can carry a \string\note, and that
        \string\note\space can carry a \string\subnote.}%
    \else
      \PackageError{grapes}{\string\subnote\space outside a \string\note}{%
        A \string\subnote\space is a note on a note. Put it inside a
        \string\note, or use \string\note.}%
    \fi
  \fi
  \grapes@newid
  \footnoteB{\grapes@subnotebody{#1}{#2}}}

% ---- \aside -------------------------------------------------------------------------
\newcommand\asidefont{\footnotesize\raggedright\linespread{1.0}\selectfont}
% An aside taller than this draws a warning: long margin notes push later
% ones down, away from their lines.
\newcommand\asidewarnheight{0.33\textheight}
\newcommand\grapes@asidechecks{%
  \ifgrapes@innote
    \PackageError{grapes}{\string\aside\space inside a note}{%
      LaTeX cannot put a margin note inside a footnote. Refer to an aside
      from a note with \string\xref\space instead.}%
  \fi
  \ifgrapes@inaside
    \PackageError{grapes}{\string\aside\space inside an \string\aside}{}%
  \fi}

% A \note inside an aside, in both modes: the mark goes in the aside now;
% the text is saved and released as an ordinary footnote in the main text,
% right after the aside. So it lands at the foot of the same page, in text
% order. (In the margin, a footnote inside the margin box would be lost. At
% the foot, bigfoot would nest it, and print it after later notes.)
\newcommand\grapes@pendingnotes{}
\newcommand\grapes@deferrednote[2]{%
  \footnotemark
  \edef\grapes@tmp{%
    \noexpand\gdef\noexpand\grapes@linkid{\grapes@linkid}%
    \noexpand\footnotetext[\the\value{footnote}]}%
  \expandafter\g@addto@macro\expandafter\grapes@pendingnotes\expandafter
    {\grapes@tmp{\grapes@notebody{#1}{#2}}}}
\newcommand\grapes@releasenotes{%
  \grapes@pendingnotes\gdef\grapes@pendingnotes{}}

\ifgrapes@margin
  % marginfix stops margin notes from overlapping. It cannot place a note
  % taller than the page: it drops it and reports only "lost some margin
  % notes" at the end of the run. \aside refuses such notes up front, with
  % the line number.
  \RequirePackage{marginfix}
  \newsavebox\grapes@asidebox
  \NewDocumentCommand\aside{O{} +m}{%
    \grapes@asidechecks
    \stepcounter{footnoteS}\grapes@checksymbols
    \grapes@newid
    \edef\grapes@asidemark{\thefootnoteS}%
    \textsuperscript{\grapes@linkedmark{\grapes@asidemark}}%
    \sbox\grapes@asidebox{\parbox[t]{\marginparwidth}{%
      \asidefont\grapes@asideflags
      \grapes@keytarget{#1}{\grapes@asidemark}%
      {\grapes@bodymarktrue
       \textsuperscript{\grapes@linkedmark{\grapes@asidemark}}}\,#2}}%
    \ifdim\dimexpr\ht\grapes@asidebox+\dp\grapes@asidebox\relax>\textheight
      \PackageError{grapes}{\string\aside\space taller than the page}{%
        It would be dropped from the output. Shorten it or make it a
        \string\note.}%
    \else\ifdim\dimexpr\ht\grapes@asidebox+\dp\grapes@asidebox\relax>\asidewarnheight
      \PackageWarning{grapes}{Long \string\aside\space (over a third of the
        page). It may push later margin notes away from their lines}%
    \fi\fi
    \marginpar{\usebox\grapes@asidebox}%
    \grapes@releasenotes}
\else
  % No margin: an aside is a footnote in series S, above the notes, with
  % the same symbol marks.
  \NewDocumentCommand\aside{O{} +m}{%
    \grapes@asidechecks
    \grapes@newid
    \footnoteS{\grapes@asideflags\grapes@keytarget{#1}{\@thefnmark}#2}%
    \grapes@checksymbols
    \grapes@releasenotes}
\fi

% ---- PDF links -----------------------------------------------------------------
% Loaded last, as hyperref requires. Links are invisible in print
% (hidelinks). hyperref's own footnote links do not work with bigfoot, so
% they are off; the links above replace them.
\RequirePackage[hidelinks,hyperfootnotes=false]{hyperref}

\endinput
