% grapes.sty -- layout for the book "Grapes". All layout decisions live here.
% Engine: LuaLaTeX. Class: book.
%
% The author uses three commands, and nothing else, for notes:
%   \note{...}     footnote, numbered, at the foot of the page.
%   \subnote{...}  note on a note. Allowed only inside \note. Lettered
%                  (letters restart each page), set in its own block below
%                  the \note block, under its own rule.
%   \aside{...}    margin note, unmarked, beside the line where it is called.
%
% Margin notes can be switched off without touching the text:
%   \usepackage{grapes}             asides go in the margin (default)
%   \usepackage[nomargin]{grapes}   asides become ordinary numbered \note's,
%                                   and the page drops the wide margin.
%
% Misuse fails loudly (a LaTeX error, not a silent drop):
%   \subnote outside a \note, a \subnote inside a \subnote,
%   a \note or \subnote inside an \aside, an \aside inside a note,
%   an \aside taller than the page. A long \aside only warns.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{grapes}[2026/09/30 Layout for Grapes]

\newif\ifgrapes@margin
\DeclareOption{margin}{\grapes@margintrue}
\DeclareOption{nomargin}{\grapes@marginfalse}
\ExecuteOptions{margin}
\ProcessOptions\relax

% ---- page ------------------------------------------------------------------
% With margin notes the page is wider, to make room for them. Without them it
% is a plain trade page. Change the numbers here and nowhere else.
\ifgrapes@margin
  \RequirePackage[paperwidth=7in, paperheight=9.5in,
                  textwidth=3.9in, textheight=7.3in,
                  inner=0.85in, top=0.9in,
                  marginparwidth=1.6in, marginparsep=0.3in]{geometry}
\else
  \RequirePackage[paperwidth=5.5in, paperheight=8.5in,
                  textwidth=3.9in, textheight=6.6in,
                  inner=0.7in, top=0.8in]{geometry}
\fi

% ---- type ------------------------------------------------------------------
\RequirePackage{fontspec}
\setmainfont{EB Garamond}[Numbers={OldStyle,Proportional}]
\RequirePackage{microtype}
\setlength\emergencystretch{1em}
\linespread{1.08}
\RequirePackage{xcolor}
\definecolor{grapeink}{HTML}{5B2A4E}   % the one accent colour

% ---- chapters and running heads -------------------------------------------
% Chapters are numbered in words ("One"), up to twenty; after that, digits.
\newcommand\grapes@numberword[1]{%
  \ifcase#1 Zero\or One\or Two\or Three\or Four\or Five\or Six\or Seven\or
  Eight\or Nine\or Ten\or Eleven\or Twelve\or Thirteen\or Fourteen\or
  Fifteen\or Sixteen\or Seventeen\or Eighteen\or Nineteen\or Twenty\else
  \number#1\fi}
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\centering\normalfont}
  {\large\scshape\color{grapeink}\grapes@numberword{\value{chapter}}}
  {0.5\baselineskip}
  {\LARGE}
\titlespacing*{\chapter}{0pt}{0.15\textheight}{3\baselineskip}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\renewcommand\chaptermark[1]{\markboth{#1}{#1}}
\fancyhead[LE]{\small\scshape Grapes}
\fancyhead[RO]{\small\scshape\leftmark}
\fancyfoot[C]{\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}}

% ---- notes: two levels at the foot (bigfoot) -------------------------------
% [ruled] puts a rule above each footnote series, so the \subnote block is
% visibly separate from the \note block. \note numbers restart each chapter
% (book class default); \subnote letters restart each page.
\RequirePackage[ruled]{bigfoot}
\DeclareNewFootnote{default}
\DeclareNewFootnote{B}[alph]
\RequirePackage{perpage}
\MakePerPage{footnoteB}

% Where we are, so misuse can be caught.
\newif\ifgrapes@innote
\newif\ifgrapes@insubnote
\newif\ifgrapes@inaside

\newcommand\grapes@noaside[1]{%
  \ifgrapes@inaside
    \PackageError{grapes}{#1 inside an \string\aside}{%
      A margin note cannot carry footnotes. Move the note out of the
      \string\aside, or turn the \string\aside\space into a \string\note.}%
  \fi}

\newcommand\note[1]{%
  \grapes@noaside{\string\note}%
  \footnote{\grapes@innotetrue#1}}

\newcommand\subnote[1]{%
  \grapes@noaside{\string\subnote}%
  \ifgrapes@insubnote
    \PackageError{grapes}{\string\subnote\space inside a \string\subnote}{%
      Only two levels of notes are set up.}%
  \fi
  \ifgrapes@innote\else
    \PackageError{grapes}{\string\subnote\space outside a \string\note}{%
      A \string\subnote\space is a note on a note. Put it inside a
      \string\note, or use \string\note.}%
  \fi
  \footnoteB{\grapes@insubnotetrue#1}}

% ---- margin notes ------------------------------------------------------------
\newcommand\asidefont{\footnotesize\raggedright\linespread{1.0}\selectfont}
% An aside taller than this draws a warning: long margin notes push later
% ones down, away from their lines.
\newcommand\asidewarnheight{0.33\textheight}

\ifgrapes@margin
  % marginfix stops margin notes from overlapping. It cannot place a note
  % taller than the page: it drops it and reports only "lost some margin
  % notes" at the end of the run. \aside refuses such notes up front, with
  % the line number.
  \RequirePackage{marginfix}
  \newsavebox\grapes@asidebox
  \newcommand\aside[1]{%
    \ifgrapes@innote
      \PackageError{grapes}{\string\aside\space inside a note}{%
        LaTeX cannot put a margin note inside a footnote.}%
    \fi
    \sbox\grapes@asidebox{\parbox[t]{\marginparwidth}{%
      \asidefont\grapes@inasidetrue#1}}%
    \ifdim\dimexpr\ht\grapes@asidebox+\dp\grapes@asidebox\relax>\textheight
      \PackageError{grapes}{\string\aside\space taller than the page}{%
        It would be dropped from the output. Shorten it or make it a
        \string\note.}%
    \else\ifdim\dimexpr\ht\grapes@asidebox+\dp\grapes@asidebox\relax>\asidewarnheight
      \PackageWarning{grapes}{Long \string\aside\space (over a third of the
        page). It may push later margin notes away from their lines}%
    \fi\fi
    \marginpar{\usebox\grapes@asidebox}}
\else
  % No margin: an aside is an ordinary numbered note. The same misuse
  % checks apply, so a text that builds one way builds the other way too.
  \newcommand\aside[1]{%
    \ifgrapes@innote
      \PackageError{grapes}{\string\aside\space inside a note}{%
        Not allowed, so that the text also builds with margin notes on.}%
    \fi
    \footnote{\grapes@inasidetrue#1}}
\fi

\endinput
