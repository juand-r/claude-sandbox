\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Predicting a judge's measured resolution limit $L_J$. Residual standard deviation is in units of true quality; lower is better. The gold-label predictors require an annotated meta-benchmark; the bias-equivalent gap $\gamma _J$ requires no labels at all. $L_J$ itself is measured with labels---the point is that $\gamma _J$ recovers it without them.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:calib}{{2}{9}{Predicting a judge's measured resolution limit $\rlim _J$. Residual standard deviation is in units of true quality; lower is better. The gold-label predictors require an annotated meta-benchmark; the bias-equivalent gap $\bgap _J$ requires no labels at all. $\rlim _J$ itself is measured with labels---the point is that $\bgap _J$ recovers it without them}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Recovering the resolution limit. \textbf  {(a)} The label-free predictor $\gamma $; dotted line is $y=x$. \textbf  {(b)} Gold-label accuracy on a clear-cut, style-matched meta-benchmark. \textbf  {Takeaway:} both are informative, but only the label-free predictor is calibrated well enough to convert into a decision about a specific leaderboard gap.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:calibration}{{4}{9}{Recovering the resolution limit. \textbf {(a)} The label-free predictor $\bgap $; dotted line is $y=x$. \textbf {(b)} Gold-label accuracy on a clear-cut, style-matched meta-benchmark. \textbf {Takeaway:} both are informative, but only the label-free predictor is calibrated well enough to convert into a decision about a specific leaderboard gap}{figure.4}{}}
