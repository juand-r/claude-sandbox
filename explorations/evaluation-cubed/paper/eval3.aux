\@writefile{toc}{\contentsline {paragraph}{Observation 1: at large gaps, ranking is essentially solved.}{7}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Observation 2: the picture inverts at small gaps.}{7}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Observation 3: limits vary by $60\times $; accuracy varies by $22$ points.}{7}{section*.15}\protected@file@percent }
