\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Recovering the resolution limit. \textbf  {(a)} The label-free predictor $\delta _{\mathrm  {style}}$; dotted line is $y=x$. \textbf  {(b)} Gold-label accuracy on a clear-cut, style-matched meta-benchmark. \textbf  {Takeaway:} both are informative, but only the label-free predictor is calibrated well enough to convert into a decision about a specific leaderboard gap.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:calibration}{{3}{7}{Recovering the resolution limit. \textbf {(a)} The label-free predictor $\dstyle $; dotted line is $y=x$. \textbf {(b)} Gold-label accuracy on a clear-cut, style-matched meta-benchmark. \textbf {Takeaway:} both are informative, but only the label-free predictor is calibrated well enough to convert into a decision about a specific leaderboard gap}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Certificate performance, averaged over 28 judge configurations, $4{,}000$ pairs each. The threshold $R_J$ is estimated from data, so the right-hand block re-estimates it on 42 items and evaluates on the disjoint 43. That split also halves the evaluation set, which independently adds sampling noise to every system mean; the two effects are reported together rather than disentangled.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:cert}{{2}{7}{Certificate performance, averaged over 28 judge configurations, $4{,}000$ pairs each. The threshold $R_J$ is estimated from data, so the right-hand block re-estimates it on 42 items and evaluates on the disjoint 43. That split also halves the evaluation set, which independently adds sampling noise to every system mean; the two effects are reported together rather than disentangled}{table.2}{}}
